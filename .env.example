# OpenTelemetry Configuration
# Endpoint for OTLP exporter (e.g., OpenTelemetry Collector, Jaeger, Tempo)
# If not set, only console exporter will be used
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Optional: Additional headers for OTLP exporter (comma-separated key=value pairs)
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=your-api-key,x-tenant-id=tenant123

# Optional: Override service name (defaults to assembly name)
# OTEL_SERVICE_NAME=Orleans.CustomSilo

# ASP.NET Core Configuration
ASPNETCORE_URLS=http://0.0.0.0:8080

# Orleans Configuration
ORLEANS_CLUSTER_ID=dev
ORLEANS_SERVICE_ID=dev-service
ORLEANS_SILO_PORT=11111
ORLEANS_GATEWAY_PORT=30000
ORLEANS_DASHBOARD_PORT=8080
